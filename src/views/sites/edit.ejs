<%- include("../layouts/header.ejs") %>

<div class="max-w-md mx-auto mt-10 p-4">
  <form action="/notes/update/<%= note._id %>" method="POST" enctype="multipart/form-data"
    class="bg-white p-4 rounded-xl shadow-lg border">

    <h2 class="text-center font-bold text-gray-700 mb-4">Chỉnh sửa ghi chú</h2>

    <% if (note.image) { %>
      <div class="mb-4 relative group">
        <img src="/images/<%= note.image %>" class="w-full h-48 object-cover rounded-lg shadow-sm">
        <div class="absolute inset-0 bg-black bg-opacity-10 rounded-lg group-hover:bg-opacity-0 transition"></div>
      </div>
    <% } %>

    <input type="text" name="title" value="<%= note.title %>" 
      class="w-full mb-3 p-2 text-base outline-none font-semibold border-b border-gray-100 focus:border-blue-400">

    <textarea name="content" class="w-full mb-3 p-2 text-sm outline-none resize-none" rows="4" required><%= note.content %></textarea>

    <div class="mb-4">
      <label class="block text-xs font-medium text-gray-500 mb-2 uppercase">Thay đổi hình ảnh</label>
      <input type="file" name="image" class="block w-full text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
    </div>

    <div class="mb-5">
      <label class="block text-xs font-medium text-gray-500 mb-2 uppercase">Màu sắc nền</label>
      <select name="color" class="w-full p-2 text-sm border rounded-lg bg-gray-50">
        <option value="bg-white" <%= note.color === 'bg-white' ? 'selected' : '' %>>Trắng</option>
        <option value="bg-yellow-100" <%= note.color === 'bg-yellow-100' ? 'selected' : '' %>>Vàng</option>
        <option value="bg-green-100" <%= note.color === 'bg-green-100' ? 'selected' : '' %>>Xanh lá</option>
        <option value="bg-blue-100" <%= note.color === 'bg-blue-100' ? 'selected' : '' %>>Xanh dương</option>
        <option value="bg-pink-100" <%= note.color === 'bg-pink-100' ? 'selected' : '' %>>Hồng</option>
      </select>
    </div>

    <div class="flex justify-between items-center">
      <a href="/" class="text-sm text-gray-400 hover:text-gray-600 transition">← Quay lại</a>
      <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg text-sm font-bold shadow-md hover:bg-blue-600 active:scale-95 transition">
        Lưu thay đổi
      </button>
    </div>

  </form>
</div>

<%- include("../layouts/footer.ejs") %>