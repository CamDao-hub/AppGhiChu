<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Note App</title>  
  <link rel="stylesheet" href="/stylesheets/output.css">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <style>
    /* Chỉnh lại font và màu nền sáng */
    body { background-color: #ffffff; color: #3c4043; font-family: 'Be Vietnam Pro', sans-serif; }
    
    /* Container chính để fix chiều cao */
    .main-container { height: calc(100vh - 64px); }
    
    /* Màu Active cho Sidebar (Vàng nhạt đặc trưng của Keep) */
    .sidebar-active { background-color: #feefc3 !important; color: #202124 !important; font-weight: 600; }
    
    /* Thanh cuộn tinh tế hơn cho bản trắng */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-thumb { background: #dadce0; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #bdc1c6; }
  </style>
</head>

<body class="overflow-hidden"> 

<header class="h-16 border-b border-gray-200 flex items-center justify-between px-4 sticky top-0 z-50 bg-white">
  <div class="flex items-center gap-4 flex-1">
    <a href="/" class="flex items-center gap-2 min-w-[240px] no-underline hover:opacity-80 transition">
      <span class="material-symbols-outlined text-[#f4b400] text-3xl">lightbulb</span>
      <span class="text-xl font-medium text-[#5f6368]">Note App</span>
    </a>

    <form action="/" method="GET" class="flex-1 max-w-2xl">
      <div class="flex items-center bg-[#f1f3f4] rounded-lg px-4 py-2 focus-within:bg-white focus-within:shadow-md transition-all group border border-transparent focus-within:border-gray-200">
        <span class="material-symbols-outlined text-gray-500 mr-3">search</span>
        <input 
          name="q"
          type="text"
          placeholder="Tìm kiếm"
          class="bg-transparent w-full outline-none text-sm text-gray-800 placeholder-gray-500"
          value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
        >
      </div>
    </form>
  </div>

  <div class="flex items-center gap-4 ml-4">
    <% if (user) { %>
      <div class="flex items-center gap-2 bg-white p-1 pr-4 rounded-full border border-gray-200 shadow-sm">
        <div class="w-8 h-8 rounded-full overflow-hidden border border-gray-100">
          <img src="https://api.dicebear.com/7.x/initials/svg?seed=<%= user.name %>" class="w-full h-full object-cover">
        </div>
        <span class="text-xs font-medium text-gray-700">Hi, <%= user.name %></span>
      </div>
      <a href="/users/logout" class="text-sm text-gray-500 hover:text-red-600 transition">Đăng xuất</a>
    <% } else { %>
      <a href="/users/login" class="bg-blue-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-700">Đăng nhập</a>
    <% } %>
  </div>
</header>

<div class="flex main-container">

  <aside class="w-[280px] pt-4 pr-2 bg-white overflow-y-auto">
    <nav class="space-y-1">
      <a href="/" class="flex items-center gap-5 px-6 py-3 rounded-r-full font-medium transition 
        <%= (typeof page !== 'undefined' && page === 'home') ? 'sidebar-active' : 'hover:bg-gray-100 text-[#5f6368]' %>">
        <span class="material-symbols-outlined">lightbulb</span>
        <span class="text-sm">Ghi chú</span>
      </a>

      <a href="/notes/trash" class="flex items-center gap-5 px-6 py-3 rounded-r-full font-medium transition 
        <%= (typeof page !== 'undefined' && page === 'trash') ? 'sidebar-active' : 'hover:bg-gray-100 text-[#5f6368]' %>">
        <span class="material-symbols-outlined">delete</span>
        <span class="text-sm">Thùng rác</span>
      </a>
    </nav>
  </aside>

  <main class="flex-1 overflow-y-auto p-8 bg-white">